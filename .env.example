PORT=3000
NODE_ENV=production

# ── Firebase Admin (اختر واحداً) ─────────────────────────────

# Render / Railway: الصق محتوى serviceAccountKey.json كسطر واحد
# تأكد أن private_key يحتوي \n وليس أسطر حقيقية داخل لوحة التحكم
FIREBASE_SERVICE_ACCOUNT_JSON=

# محلي: مسار الملف
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# حماية API (موصى به على Render)
API_SECRET=change-me-to-random-string

ALLOWED_ORIGINS=*
